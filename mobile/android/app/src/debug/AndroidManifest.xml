<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Yalnızca debug: yerel dev backend'i (http://10.0.2.2:4000, TLS yok)
         adresine erişebilmek için düz HTTP'ye izin verir. Release manifestinde
         (src/main) bu bayrak YOK — üretimde backend HTTPS ile sunulmalı ve
         cleartext trafik reddedilmelidir. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
