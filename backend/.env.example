DATABASE_URL=postgresql://nilufer:change_me@localhost:5433/nilufer_yonetim?schema=public
JWT_SECRET=change_me_to_a_long_random_string
PORT=4000

# Production'da web panelinin gerçek domain'i (virgülle ayrılmış birden
# fazla origin olabilir, örn. https://panel.ornek.com,https://www.ornek.com).
# Boş bırakılırsa (dev varsayılanı) her origin'e izin verilir.
CORS_ORIGIN=

# Yalnızca bir reverse proxy/load balancer (Nginx, Cloudflare, bir PaaS vb.)
# arkasında çalışıyorsanız "1" yapın — IP bazlı rate limiting'in gerçek
# istemci IP'sini görmesi için gerekir. Doğrudan internete açıksa BOŞ
# bırakılmalı (aksi halde X-Forwarded-For taklit edilerek rate limit
# atlatılabilir).
TRUST_PROXY=

# Flutter mobil uygulamasının reCAPTCHA'yı atlaması için paylaşılan sır
# (X-Mobile-App-Key header'ıyla eşleştirilir). Boş bırakılırsa mobil bypass
# hiç çalışmaz (fail-closed) — web akışı bundan etkilenmez.
MOBILE_APP_SECRET=

# Web panelinin kullanıcı tarafından erişilen tam adresi — şifre sıfırlama
# e-postasındaki linkte kullanılır (/sifre-sifirla?token=...). Boş bırakılırsa
# http://localhost:3000 varsayılır (dev).
WEB_APP_URL=

# Push bildirimleri (FCM) — Firebase servis hesabı JSON'ının TEK SATIRLIK hâli
# (veya base64'ü). Boş bırakılırsa push bildirimleri sessizce atlanır, yalnızca
# uygulama içi bildirimler çalışmaya devam eder (hiçbir hata oluşmaz). Nasıl
# alınacağı için PROJECT_HANDOFF_TR.md'deki "Firebase Kurulumu" bölümüne bakın.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Backend API'nin DIŞARIDAN (telefonun takvim uygulamasından) erişilen tam
# adresi — Bölüm AP takvim aboneliği linkinde (/calendar/<token>.ics) kullanılır.
# http://localhost:4000 varsayılır (dev).
API_PUBLIC_URL=

# S3-uyumlu nesne depolama (AWS S3, Cloudflare R2, MinIO, Backblaze B2 ...) —
# iş fotoğrafları, imzalar, müşteri belgeleri, mesaj ekleri için. Üçü de
# (BUCKET + iki anahtar) tanımlı DEĞİLSE dosyalar eskisi gibi yerel diske
# (backend/uploads/) yazılır — tek instance'lık dev/küçük kurulumlar için
# yeterlidir. Birden fazla backend instance'ı (yatay ölçekleme) çalıştıracaksanız
# ZORUNLUDUR, aksi halde instance'lar birbirinin yüklediği dosyaları göremez.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AWS S3 için bölge (örn. eu-central-1); R2/MinIO gibi S3-uyumlu servisler için
# genelde "auto" veya sağlayıcının istediği değer.
S3_REGION=
# Yalnızca AWS DIŞI bir S3-uyumlu servis kullanıyorsanız (R2, MinIO, B2) o
# servisin endpoint URL'i; gerçek AWS S3 kullanıyorsanız boş bırakın.
S3_ENDPOINT=

# Hata izleme (opsiyonel) — Sentry DSN. Boş bırakılırsa hatalar yalnızca
# konsola (yapılandırılmış JSON log) yazılır, hiçbir dış servise gönderilmez.
SENTRY_DSN=
