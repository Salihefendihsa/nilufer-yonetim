DATABASE_URL=postgresql://nilufer:change_me@localhost:5433/nilufer_yonetim?schema=public
JWT_SECRET=change_me_to_a_long_random_string
PORT=4000

# Production'da web panelinin gerçek domain'i (virgülle ayrılmış birden
# fazla origin olabilir, örn. https://panel.ornek.com,https://www.ornek.com).
# Boş bırakılırsa (dev varsayılanı) her origin'e izin verilir.
CORS_ORIGIN=

# Yalnızca bir reverse proxy/load balancer (Nginx, Cloudflare, bir PaaS vb.)
# arkasında çalışıyorsanız "1" yapın — IP bazlı rate limiting'in gerçek
# istemci IP'sini görmesi için gerekir. Doğrudan internete açıksa BOŞ
# bırakılmalı (aksi halde X-Forwarded-For taklit edilerek rate limit
# atlatılabilir).
TRUST_PROXY=

# Flutter mobil uygulamasının reCAPTCHA'yı atlaması için paylaşılan sır
# (X-Mobile-App-Key header'ıyla eşleştirilir). Boş bırakılırsa mobil bypass
# hiç çalışmaz (fail-closed) — web akışı bundan etkilenmez.
MOBILE_APP_SECRET=
