# PostgreSQL (used by docker-compose)
POSTGRES_USER=nilufer
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nilufer_yonetim
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql://nilufer:change_me@localhost:5433/nilufer_yonetim?schema=public
JWT_SECRET=change_me_to_a_long_random_string
PORT=4000

# Production'da web panelinin gerçek domain'i (virgülle ayrılmış birden
# fazla origin olabilir). Boş bırakılırsa (dev varsayılanı) her origin'e
# izin verilir.
CORS_ORIGIN=

# Yalnızca bir reverse proxy/load balancer arkasında çalışıyorsanız "1"
# yapın (IP bazlı rate limiting için gerekir). Doğrudan internete açıksa
# BOŞ bırakılmalı.
TRUST_PROXY=

# Flutter mobil uygulamasının reCAPTCHA'yı atlaması için paylaşılan sır
# (X-Mobile-App-Key header'ıyla eşleştirilir). Boş bırakılırsa mobil bypass
# hiç çalışmaz (fail-closed) — web akışı bundan etkilenmez.
MOBILE_APP_SECRET=

# Email (opsiyonel) — boş bırakılırsa email gönderimi sessizce atlanır.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail kullanıyorsan normal şifre değil, myaccount.google.com/apppasswords
# adresinden oluşturacağın bir "Uygulama Şifresi" gerekir.
SMTP_PASS=

# Google reCAPTCHA v3 (opsiyonel) — google.com/recaptcha/admin adresinden alınır.
RECAPTCHA_SECRET_KEY=
