generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  TEAM_LEAD
  STAFF
  CUSTOMER
}

enum JobStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StaffStatus {
  AVAILABLE
  ON_JOB
  ON_BREAK
  ON_LEAVE
  OFFLINE
}

enum ProductCategory {
  BIOCIDAL
  CONSUMABLE
  EQUIPMENT
  DISINFECTANT
}

enum ExpenseCategory {
  FUEL
  CHEMICALS
  EQUIPMENT
  RENT
  UTILITIES
  OTHER
}

/// Depo ikmal/satın alma talebi durumu (Stitch Müdür → Stok → "Satın Alma Talebi").
enum PurchaseRequestStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockMovementType {
  IN
  OUT
}

enum RecurrenceType {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum JobPhotoType {
  BEFORE
  AFTER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  fullName     String
  phone        String?
  /// Şifre sıfırlama sonrası (unutulan/OWNER tarafından sıfırlanan) tüm
  /// mevcut JWT'leri geçersiz kılmak için — requireAuth her istekte bunu
  /// token'daki tokenVersion ile karşılaştırır, uyuşmazsa 401 döner. Normal
  /// logout bunu ARTIRMAZ (yalnızca o oturumu kapatır, diğer cihazları
  /// etkilemez); yalnızca güvenlik olayları (şifre sıfırlama) artırır.
  tokenVersion Int      @default(0)
  /// OWNER birinin şifresini sıfırladığında true olur — login sonrası
  /// kullanıcı zorunlu şifre değiştirme ekranına düşer, o ekranı/temel
  /// auth uçlarını dışında hiçbir uca erişemez (bkz. middleware/auth.ts).
  mustChangePassword Boolean @default(false)
  /// İşten çıkarılan (terminate edilen) kullanıcı için false — login'de
  /// reddedilir (bkz. middleware/auth.ts). Hiçbir veri silinmez, yalnızca
  /// bu bayrakla gizlenir; POST /users/:id/reactivate ile geri açılır.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  customer Customer?
  staff    Staff?
  notificationPreference NotificationPreference?

  conversationsAsA Conversation[] @relation("ConversationParticipantA")
  conversationsAsB Conversation[] @relation("ConversationParticipantB")
  messages         Message[]
  notifications    Notification[]
  auditLogsAsActor  AuditLog[] @relation("AuditLogActor")
  auditLogsAsTarget AuditLog[] @relation("AuditLogTarget")
  uploadedJobPhotos JobPhoto[]
  sessions          UserSession[]
  approvedJobReports JobReport[]           @relation("JobReportApprovedBy")
  requestedPurchases StockPurchaseRequest[] @relation("PurchaseRequestedBy")
  receivedPurchases  StockPurchaseRequest[] @relation("PurchaseReceivedBy")
  observerAccessGrants ObserverAccessGrant[]
  evaluationsGiven     Evaluation[]          @relation("EvaluationEvaluator")
  passwordResetTokens  PasswordResetToken[]
  impersonationsAsOwner  ImpersonationSession[] @relation("ImpersonationOwner")
  impersonationsAsTarget ImpersonationSession[] @relation("ImpersonationTarget")
  leaveRequestDecisions LeaveRequest[] @relation("LeaveRequestDecidedBy")
  recordedExpenses Expense[]

  @@index([role])
}

/// "Şifremi Unuttum" akışı — ham token asla DB'de durmaz, yalnızca hash'i
/// (bkz. lib/passwordReset.ts). Token e-posta ile gönderilir, DB'de sadece
/// hash tutulduğu için bir DB sızıntısı bile geçerli bir sıfırlama linki
/// üretmeye yetmez.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

/// OWNER'ın başka bir kullanıcı hesabına (OWNER hariç) "impersonate" ile
/// girmesi — tam hesap verebilirlik için gerekçe zorunlu, başlangıç/bitiş
/// zaman damgalı. bkz. middleware/auth.ts (impersonatedBy JWT claim'i) ve
/// lib/auditLog.ts (impersonasyon sırasındaki her audit log kaydına not düşer).
model ImpersonationSession {
  id            String    @id @default(uuid())
  ownerUserId   String
  targetUserId  String
  reason        String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  owner  User @relation("ImpersonationOwner", fields: [ownerUserId], references: [id])
  target User @relation("ImpersonationTarget", fields: [targetUserId], references: [id])

  @@index([ownerUserId])
  @@index([targetUserId])
  @@index([endedAt])
}

model Customer {
  id        String   @id @default(uuid())
  userId    String?  @unique
  fullName  String
  phone     String
  email     String?
  address   String?
  district  String?
  createdAt DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id])
  jobs      Job[]
  contracts Contract[]
  payments  Payment[]

  @@index([district])
  @@index([phone])
}

model Staff {
  id           String   @id @default(uuid())
  userId       String   @unique
  position     String
  salaryBase   Decimal  @db.Decimal(10, 2)
  /// Organizasyon zincirindeki üst: STAFF/TEAM_LEAD → TEAM_LEAD ise bu bir
  /// Staff.id'dir (eski davranış); STAFF/TEAM_LEAD → MANAGER'a doğrudan
  /// bağlanıyorsa bu bir User.id'dir (MANAGER'ın kendi Staff kaydı yok —
  /// bkz. lib/access.ts:resolveSupervisorInfo). Bu yüzden bilerek gerçek bir
  /// FK ilişkisi YOK (tek bir tabloya işaret etmiyor); geçerlilik
  /// controller'da (createStaff/updateStaff) uygulama seviyesinde kontrol
  /// edilir.
  supervisorId String?
  status       StaffStatus @default(AVAILABLE)
  statusUntil  DateTime?
  /// Zimmetli araç plakası (Stitch Müdür → Personel → "Zimmetli Araç").
  vehiclePlate String?
  /// Günlük iş kapasitesi — "4/5 İş (%80)" göstergesinin paydası. Boşsa
  /// yüzde gösterilmez, yalnızca iş sayısı gösterilir (uydurma kapasite yok).
  dailyJobCapacity Int?
  createdAt    DateTime @default(now())
  /// Doldurulmuşsa bu Staff kaydı "arşivlenmiş" sayılır — MÜDÜR'e terfi
  /// (Staff kaydına artık ihtiyaç yok) veya işten çıkarma sonucu. Hiçbir
  /// veri silinmez (maaş/iş/değerlendirme geçmişi korunur); aktif personel
  /// sorgularının hepsi `archivedAt: null` ile filtrelenir. Düşürme/geri
  /// aktif etmede null'a geri döner (aynı Staff kaydı yeniden kullanılır).
  archivedAt   DateTime?

  user            User             @relation(fields: [userId], references: [id])
  jobs            Job[]            @relation("AssignedStaff")
  jobReports      JobReport[]
  advanceRequests AdvanceRequest[]
  leaveRequests LeaveRequest[]
  permissions     Permission[]
  certifications  StaffCertification[]
  collectedPayments Payment[]      @relation("PaymentCollectedBy")
  evaluationsReceived Evaluation[] @relation("EvaluationTarget")

  @@index([position])
  @@index([supervisorId])
  @@index([archivedAt])
}

model StaffCertification {
  id          String    @id @default(uuid())
  staffId     String
  name        String
  issuedDate  DateTime
  expiryDate  DateTime
  documentUrl String?
  createdAt   DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([expiryDate])
}

model Permission {
  id        String   @id @default(uuid())
  staffId   String
  key       String
  value     Boolean  @default(false)
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, key])
  @@index([staffId])
}

model AdvanceRequest {
  id        String        @id @default(uuid())
  staffId   String
  amount    Decimal       @db.Decimal(10, 2)
  reason    String
  status    AdvanceStatus @default(PENDING)
  createdAt DateTime      @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([status])
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// İzin talep/onay akışı — onaylanınca Staff.status=ON_LEAVE,
/// Staff.statusUntil=endDate olur; mevcut resetExpiredStaffStatuses cron'u
/// (lib/cron.ts) süre dolunca otomatik AVAILABLE'a döndürür, ayrı bir cron
/// gerekmez.
model LeaveRequest {
  id              String             @id @default(uuid())
  staffId         String
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          LeaveRequestStatus @default(PENDING)
  requestedAt     DateTime           @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  decisionNote    String?

  staff        Staff @relation(fields: [staffId], references: [id])
  decidedByUser User? @relation("LeaveRequestDecidedBy", fields: [decidedByUserId], references: [id])

  @@index([staffId])
  @@index([status])
}

model Job {
  id               String    @id @default(uuid())
  /// İnsan-okunur iş numarası (#NLF-4819 gösterimi). Postgres sequence ile
  /// üretilir; mevcut satırlar migration sırasında otomatik numaralandırılır.
  sequenceNo       Int       @default(autoincrement())
  customerId       String
  assignedStaffId  String?
  serviceType      String
  status           JobStatus @default(PENDING)
  scheduledAt      DateTime?
  /// Randevu penceresinin bitişi ("09:30 - 11:00" gösterimi) ve zamanında
  /// tamamlama oranı hesabının referansı.
  scheduledEndAt   DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?
  notes            String?
  price            Decimal?  @db.Decimal(10, 2)
  rating           Int?
  ratingComment    String?
  createdAt        DateTime  @default(now())

  customer       Customer    @relation(fields: [customerId], references: [id])
  assignedStaff  Staff?      @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  jobReports     JobReport[]
  photos         JobPhoto[]

  @@index([customerId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([scheduledAt])
  @@index([sequenceNo])
}

model JobPhoto {
  id               String       @id @default(uuid())
  jobId            String
  url              String
  type             JobPhotoType
  uploadedByUserId String
  createdAt        DateTime     @default(now())

  job          Job  @relation(fields: [jobId], references: [id])
  uploadedBy   User @relation(fields: [uploadedByUserId], references: [id])

  @@index([jobId])
}

model JobReport {
  id            String   @id @default(uuid())
  jobId         String
  staffId       String
  productId     String?
  quantity      Decimal? @db.Decimal(10, 2)
  productsUsed  String?
  dosage        String
  notes         String?
  signatureUrl  String?
  pdfUrl        String?
  /// Müdür/patron saha raporu onayı (Stitch Müdür → İşler → "Raporu Onayla").
  approvedAt        DateTime?
  approvedByUserId  String?
  createdAt     DateTime @default(now())

  job           Job            @relation(fields: [jobId], references: [id])
  staff         Staff          @relation(fields: [staffId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  approvedBy    User?          @relation("JobReportApprovedBy", fields: [approvedByUserId], references: [id])
  /// Eski tekli-ürün akışı için (bkz. `productId`/`quantity` alanları) —
  /// yeni raporlar `products` (JobReportProduct) kullanır, bu alan artık
  /// yalnızca geriye dönük uyumluluk için `unique` bir StockMovement taşır.
  stockMovement StockMovement?
  /// Stitch Personel → İşler: "Kullanılan Ürünler (Stoktan Düşüm)" — bir
  /// raporda BİRDEN FAZLA ürün seçilip her biri için ayrı miktar/stepper
  /// girilebilir. Her satır kendi StockMovement(OUT) kaydını üretir.
  products      JobReportProduct[]

  @@index([jobId])
  @@index([staffId])
  @@index([productId])
  @@index([approvedAt])
}

/// Bir saha raporunda kullanılan birden fazla ürünü (ve stoktan düşülen
/// miktarını) tutar — bkz. JobReport.products. Faz 9 (Personel) ile
/// eklendi: Stitch "İşler" ekranındaki çoklu ürün + miktar stepper'ı
/// gerçek bir tekli `productId`/`quantity` alanıyla karşılanamıyordu.
model JobReportProduct {
  id          String   @id @default(uuid())
  jobReportId String
  productId   String
  quantity    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  jobReport     JobReport      @relation(fields: [jobReportId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  stockMovement StockMovement?

  @@index([jobReportId])
  @@index([productId])
}

model Product {
  id                String   @id @default(uuid())
  /// Depo/stok kodu (INS-402, ROD-108 gibi) — Stitch Müdür → Stok listesi.
  code              String?
  name              String
  unit              String
  /// Etken madde / ambalaj açıklaması ("Balmumu Bazlı Parafin Blok · 5 Kg Kova").
  description       String?
  category          ProductCategory @default(BIOCIDAL)
  currentStock      Decimal  @db.Decimal(10, 2)
  criticalThreshold Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())

  movements         StockMovement[]
  jobReports        JobReport[]
  jobReportProducts JobReportProduct[]
  purchaseRequests  StockPurchaseRequest[]

  @@index([name])
}

model StockMovement {
  id                        String            @id @default(uuid())
  productId                 String
  type                      StockMovementType
  quantity                  Decimal           @db.Decimal(10, 2)
  /// Eski tekli-ürün raporu akışı (bkz. JobReport.productId) — yeni çoklu
  /// ürün raporları `relatedJobReportProductId` kullanır.
  relatedJobReportId        String?           @unique
  relatedJobReportProductId String?           @unique
  note                      String?
  createdAt                 DateTime          @default(now())

  product                 Product           @relation(fields: [productId], references: [id])
  relatedJobReport        JobReport?        @relation(fields: [relatedJobReportId], references: [id])
  relatedJobReportProduct JobReportProduct? @relation(fields: [relatedJobReportProductId], references: [id])

  @@index([productId])
}

/// Depo ikmal / satın alma talebi. Müdür "Satın Alma Talebi" oluşturur
/// (stok HEMEN artmaz, "Sipariş Bekleyen" olarak görünür); mal kabul
/// edildiğinde (RECEIVED) tek bir transaction içinde stok artar ve bir
/// StockMovement(IN) kaydı düşülür.
model StockPurchaseRequest {
  id               String                @id @default(uuid())
  productId        String
  quantity         Decimal               @db.Decimal(10, 2)
  status           PurchaseRequestStatus @default(PENDING)
  note             String?
  requestedByUserId String
  receivedAt       DateTime?
  receivedByUserId String?
  createdAt        DateTime              @default(now())

  product      Product @relation(fields: [productId], references: [id])
  requestedBy  User    @relation("PurchaseRequestedBy", fields: [requestedByUserId], references: [id])
  receivedBy   User?   @relation("PurchaseReceivedBy", fields: [receivedByUserId], references: [id])

  @@index([productId])
  @@index([status])
}

model Contract {
  id                 String          @id @default(uuid())
  customerId         String
  startDate          DateTime
  endDate            DateTime
  durationMonths     Int
  status             String
  serviceType        String?
  amount             Decimal?        @db.Decimal(10, 2)
  pdfUrl             String?
  recurrenceType     RecurrenceType?
  nextGenerationDate DateTime?
  createdAt          DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([nextGenerationDate])
}

model Payment {
  id          String   @id @default(uuid())
  customerId  String
  amount      Decimal  @db.Decimal(10, 2)
  paymentType String
  /// Dekont / referans numarası ("Dekont: #BNK-88219", "Ref #2024-89").
  referenceNo String?
  /// Saha tahsilatını yapan personel (Stitch: "Ahmet T. (Teknisyen)").
  collectedByStaffId String?
  receiptUrl  String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  collectedByStaff Staff? @relation("PaymentCollectedBy", fields: [collectedByStaffId], references: [id])

  @@index([customerId])
  @@index([paymentType])
  @@index([collectedByStaffId])
}

/// Gider takibi — net kâr hesaplaması artık tahsilat - personel maaş tabanı
/// - o aydaki toplam gideri kullanır (bkz. paymentsController.ts:
/// getPaymentsSummary). view_finance ile aynı görünürlük kuralı geçerli.
model Expense {
  id               String           @id @default(uuid())
  category         ExpenseCategory
  amount           Decimal          @db.Decimal(10, 2)
  description      String?
  date             DateTime
  recordedByUserId String
  receiptUrl       String?
  createdAt        DateTime         @default(now())

  recordedByUser User @relation(fields: [recordedByUserId], references: [id])

  @@index([category])
  @@index([date])
}

model Conversation {
  id              String   @id @default(uuid())
  participantAId  String
  participantBId  String
  createdAt       DateTime @default(now())

  participantA User      @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantB User      @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  messages     Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  /// Saha fotoğrafı eki (Stitch Şef → Mesaj Detayı). Göreli yol (/uploads/...),
  /// iş fotoğraflarıyla aynı multer altyapısını kullanır.
  attachmentUrl  String?
  /// Şimdilik yalnızca "image"; ileride başka tür eklenirse ayrımı korur.
  attachmentType String?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model QuoteRequest {
  id          String   @id @default(uuid())
  fullName    String
  phone       String
  email       String?
  propertyType String
  serviceType String
  address     String?
  district    String?
  amount      Decimal? @db.Decimal(10, 2)
  /// Müdür notu (Stitch Müdür → Teklifler → "Not Ekle").
  note        String?
  /// Keşif randevusu (Stitch → "Keşif Randevusu Ver").
  surveyAt    DateTime?
  /// Müşteriye dönüştürüldüğü an — "ortalama dönüşüm süresi" hesabı için.
  convertedAt DateTime?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([district])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  title       String
  body        String?
  type        String?
  relatedType String?
  relatedId   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([readAt])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ServiceType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model District {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  emailEnabled        Boolean  @default(true)
  dailyDigestEnabled  Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  loginAt      DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  logoutAt     DateTime?
  deviceInfo   String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loginAt])
}

/// Gözlemci Modu erişim izni — OWNER, GET /conversations/all'a erişmeden önce
/// gerekçeli ve süreli (veya acil durumda süresiz) bir izin talep etmek
/// zorundadır. Bu, "OWNER'ın her şeyi görebilmesi" ile "her erişimin izlenip
/// hesap verebilir olması" arasında bir denge kurar.
model ObserverAccessGrant {
  id                String    @id @default(uuid())
  requestedByUserId String
  reason            String
  expiresAt         DateTime?
  isEmergency       Boolean   @default(false)
  createdAt         DateTime  @default(now())

  requestedBy User @relation(fields: [requestedByUserId], references: [id])

  @@index([requestedByUserId])
  @@index([expiresAt])
}

/// Formal Değerlendirme sisteminin kriter kataloğu — mevcut basit
/// Performans sayfasından (tamamlanan iş + müşteri puanı) bağımsız, ayrı bir
/// bölüm olarak eklenir; o sayfanın mantığı değişmez.
model EvaluationCriterion {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  scores EvaluationScore[]

  @@index([isActive])
}

model EvaluationPeriod {
  id        String   @id @default(uuid())
  label     String
  startDate DateTime
  endDate   DateTime
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())

  evaluations Evaluation[]
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

model Evaluation {
  id              String           @id @default(uuid())
  evaluatorUserId String
  targetStaffId   String
  periodId        String
  status          EvaluationStatus @default(DRAFT)
  comment         String?
  /// Opsiyonel ek genel puan (1-20) — kriter ortalamasından (averageScore,
  /// her okumada hesaplanır) AYRIDIR, asla birbirine karışmaz/üzerine yazmaz.
  managerScore    Int?
  submittedAt     DateTime?
  lockedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  evaluator User             @relation("EvaluationEvaluator", fields: [evaluatorUserId], references: [id])
  target    Staff            @relation("EvaluationTarget", fields: [targetStaffId], references: [id])
  period    EvaluationPeriod @relation(fields: [periodId], references: [id])
  scores    EvaluationScore[]

  @@unique([evaluatorUserId, targetStaffId, periodId])
  @@index([targetStaffId])
  @@index([periodId])
  @@index([status])
}

model EvaluationScore {
  id           String @id @default(uuid())
  evaluationId String
  criterionId  String
  /// 1-20 arası, Zod ile validate edilir.
  score        Int

  evaluation Evaluation           @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion  @relation(fields: [criterionId], references: [id])

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  targetUserId String
  targetType   String?
  targetId     String?
  detail       String?
  createdAt    DateTime @default(now())

  actor  User @relation("AuditLogActor", fields: [actorUserId], references: [id])
  target User @relation("AuditLogTarget", fields: [targetUserId], references: [id])

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}
