generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  TEAM_LEAD
  STAFF
  CUSTOMER
}

enum JobStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StaffStatus {
  AVAILABLE
  ON_JOB
  ON_BREAK
  ON_LEAVE
  OFFLINE
}

enum ProductCategory {
  BIOCIDAL
  CONSUMABLE
  EQUIPMENT
  DISINFECTANT
}

enum ExpenseCategory {
  FUEL
  CHEMICALS
  EQUIPMENT
  RENT
  UTILITIES
  /// Bölüm C (2. tur): onaylanan bir StaffBonus için otomatik oluşturulan
  /// Expense'in kategorisi — net kâr hesaplamasına gerçekten yansısın diye.
  BONUS
  OTHER
}

/// Depo ikmal/satın alma talebi durumu (Stitch Müdür → Stok → "Satın Alma Talebi").
enum PurchaseRequestStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockMovementType {
  IN
  OUT
}

enum RecurrenceType {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum JobPhotoType {
  BEFORE
  AFTER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  fullName     String
  phone        String?
  /// Şifre sıfırlama sonrası (unutulan/OWNER tarafından sıfırlanan) tüm
  /// mevcut JWT'leri geçersiz kılmak için — requireAuth her istekte bunu
  /// token'daki tokenVersion ile karşılaştırır, uyuşmazsa 401 döner. Normal
  /// logout bunu ARTIRMAZ (yalnızca o oturumu kapatır, diğer cihazları
  /// etkilemez); yalnızca güvenlik olayları (şifre sıfırlama) artırır.
  tokenVersion Int      @default(0)
  /// OWNER birinin şifresini sıfırladığında true olur — login sonrası
  /// kullanıcı zorunlu şifre değiştirme ekranına düşer, o ekranı/temel
  /// auth uçlarını dışında hiçbir uca erişemez (bkz. middleware/auth.ts).
  mustChangePassword Boolean @default(false)
  /// İşten çıkarılan (terminate edilen) kullanıcı için false — login'de
  /// reddedilir (bkz. middleware/auth.ts). Hiçbir veri silinmez, yalnızca
  /// bu bayrakla gizlenir; POST /users/:id/reactivate ile geri açılır.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  /// TOTP sırrı (base32) — yalnızca OWNER/MANAGER için kullanılabilir (bkz.
  /// docs/NEW_FEATURES_TOUR.md Bölüm D). /2fa/setup ile üretilir ama
  /// /2fa/enable ile kod doğrulanana kadar twoFactorEnabled false kalır.
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
  /// Push bildirimi (FCM) cihaz token'ları — bir kullanıcı birden fazla
  /// cihazda oturum açabildiği için dizi. Firebase yapılandırılmamışsa
  /// (FIREBASE_SERVICE_ACCOUNT_KEY yoksa) bu alan hiç kullanılmaz, yalnızca
  /// uygulama içi bildirimler çalışmaya devam eder (bkz. lib/push.ts).
  fcmTokens String[] @default([])

  customer Customer?
  staff    Staff?
  notificationPreference NotificationPreference?

  conversationsAsA Conversation[] @relation("ConversationParticipantA")
  conversationsAsB Conversation[] @relation("ConversationParticipantB")
  messages         Message[]
  notifications    Notification[]
  auditLogsAsActor  AuditLog[] @relation("AuditLogActor")
  auditLogsAsTarget AuditLog[] @relation("AuditLogTarget")
  uploadedJobPhotos JobPhoto[]
  sessions          UserSession[]
  approvedJobReports JobReport[]           @relation("JobReportApprovedBy")
  requestedPurchases StockPurchaseRequest[] @relation("PurchaseRequestedBy")
  receivedPurchases  StockPurchaseRequest[] @relation("PurchaseReceivedBy")
  observerAccessGrants ObserverAccessGrant[]
  evaluationsGiven     Evaluation[]          @relation("EvaluationEvaluator")
  passwordResetTokens  PasswordResetToken[]
  impersonationsAsOwner  ImpersonationSession[] @relation("ImpersonationOwner")
  impersonationsAsTarget ImpersonationSession[] @relation("ImpersonationTarget")
  leaveRequestDecisions LeaveRequest[] @relation("LeaveRequestDecidedBy")
  appointmentRequestResponses AppointmentRequest[] @relation("AppointmentRequestRespondedBy")
  onboardingCompletions OnboardingChecklistItem[] @relation("OnboardingCompletedBy")
  uploadedCustomerDocuments CustomerDocument[] @relation("CustomerDocumentUploadedBy")
  processedDeletionRequests DataDeletionRequest[] @relation("DataDeletionProcessedBy")
  /// Bölüm AK (8. tur)
  announcements             Announcement[]
  assignedComplaints        CustomerComplaint[] @relation("ComplaintAssignedTo")
  recordedExpenses Expense[]
  twoFactorRecoveryCodes TwoFactorRecoveryCode[]
  twoFactorChallenges    TwoFactorChallenge[]
  staffBonusesApproved   StaffBonus[] @relation("StaffBonusApprovedBy")

  @@index([role])
}

/// /2fa/enable sırasında üretilen 10 tek kullanımlık kurtarma kodu — ham kod
/// yalnızca üretim anında bir kez döner, DB'de PasswordResetToken ile aynı
/// prensiple yalnızca hash'i (sha256) durur.
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// Şifre doğru + twoFactorEnabled=true olduğunda login() JWT YERİNE bunu
/// döner — yalnızca /auth/2fa/verify'de kullanılabilir, 5 dk geçerli, tek
/// kullanımlık. PasswordResetToken ile aynı hash-only saklama prensibi.
model TwoFactorChallenge {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

/// "Şifremi Unuttum" akışı — ham token asla DB'de durmaz, yalnızca hash'i
/// (bkz. lib/passwordReset.ts). Token e-posta ile gönderilir, DB'de sadece
/// hash tutulduğu için bir DB sızıntısı bile geçerli bir sıfırlama linki
/// üretmeye yetmez.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

/// OWNER'ın başka bir kullanıcı hesabına (OWNER hariç) "impersonate" ile
/// girmesi — tam hesap verebilirlik için gerekçe zorunlu, başlangıç/bitiş
/// zaman damgalı. bkz. middleware/auth.ts (impersonatedBy JWT claim'i) ve
/// lib/auditLog.ts (impersonasyon sırasındaki her audit log kaydına not düşer).
model ImpersonationSession {
  id            String    @id @default(uuid())
  ownerUserId   String
  targetUserId  String
  reason        String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?

  owner  User @relation("ImpersonationOwner", fields: [ownerUserId], references: [id])
  target User @relation("ImpersonationTarget", fields: [targetUserId], references: [id])

  @@index([ownerUserId])
  @@index([targetUserId])
  @@index([endedAt])
}

model Customer {
  id        String   @id @default(uuid())
  userId    String?  @unique
  fullName  String
  phone     String
  email     String?
  address   String?
  district  String?
  /// Bölüm P (4. tur): Arkadaşını Davet Et — kısa alfanumerik davet kodu
  /// (lib/referral.ts). Eski kayıtlar için null; ilk istendiğinde üretilir.
  referralCode          String?  @unique
  /// Bu müşteriyi davet eden müşteri (teklif ?ref= → convert akışında set edilir).
  referredByCustomerId  String?
  createdAt DateTime @default(now())

  user      User?      @relation(fields: [userId], references: [id])
  referredBy      Customer?  @relation("CustomerReferral", fields: [referredByCustomerId], references: [id])
  referredCustomers Customer[] @relation("CustomerReferral")
  jobs      Job[]
  contracts Contract[]
  payments  Payment[]
  appointmentRequests AppointmentRequest[]
  tagAssignments CustomerTagAssignment[]
  documents CustomerDocument[]
  deletionRequests DataDeletionRequest[]
  complaints CustomerComplaint[]

  @@index([district])
  @@index([phone])
  @@index([referredByCustomerId])
}

/// Bölüm AD (7. tur): KVKK — müşterinin kişisel verilerinin silinmesi talebi.
/// Onayda GERÇEK silme değil anonimleştirme: Customer.fullName → "Silinmiş
/// Müşteri", phone/email/address → placeholder/null, User pasif + token iptali;
/// Job/Payment/Contract kayıtları KALIR (mali/yasal kayıt zorunluluğu).
enum DataDeletionStatus {
  PENDING
  COMPLETED
  REJECTED
}

model DataDeletionRequest {
  id                String             @id @default(uuid())
  customerId        String
  status            DataDeletionStatus @default(PENDING)
  requestedAt       DateTime           @default(now())
  processedByUserId String?
  processedAt       DateTime?
  rejectionReason   String?

  customer    Customer @relation(fields: [customerId], references: [id])
  processedBy User?    @relation("DataDeletionProcessedBy", fields: [processedByUserId], references: [id])

  @@index([customerId])
  @@index([status])
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
}

/// Bölüm AO (9. tur): Müşteri şikayet/sorun bildirimi — basit iş puanlamasından
/// (Job.rating) AYRI, çözüm takipli bir akış. CUSTOMER kendi adına açar;
/// OWNER/MANAGER durum/öncelik/atama/çözüm notu günceller. RESOLVED/CLOSED'a
/// geçişte resolvedAt damgalanır ve müşteriye bildirim gider. Bekleyen
/// Onaylar'a EKLENMEZ — ayrı "Şikayetler" sayfası.
model CustomerComplaint {
  id               String            @id @default(uuid())
  customerId       String
  jobId            String?
  subject          String
  description      String
  status           ComplaintStatus   @default(OPEN)
  priority         ComplaintPriority @default(MEDIUM)
  assignedToUserId String?
  resolutionNote   String?
  createdAt        DateTime          @default(now())
  resolvedAt       DateTime?

  customer   Customer @relation(fields: [customerId], references: [id])
  job        Job?     @relation(fields: [jobId], references: [id])
  assignedTo User?    @relation("ComplaintAssignedTo", fields: [assignedToUserId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
}

/// Bölüm AK (8. tur): Sistem geneli duyuru şeridi — aynı anda en fazla 1 aktif
/// duyuru (yeni POST öncekini işlemde pasifleştirir). expiresAt geçmişse /active null.
model Announcement {
  id              String    @id @default(uuid())
  message         String
  isActive        Boolean   @default(true)
  createdByUserId String
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([isActive])
}

/// Bölüm AB (6. tur): Müşteri belge kasası — sözleşme taraması, kimlik
/// fotokopisi vb. JobPhoto ile aynı upload altyapısı (lib/upload.ts,
/// /uploads statik). Silmede DB kaydı + diskteki dosya birlikte kaldırılır.
model CustomerDocument {
  id               String   @id @default(uuid())
  customerId       String
  fileName         String
  fileUrl          String
  fileType         String
  fileSize         Int
  uploadedByUserId String
  uploadedAt       DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("CustomerDocumentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([customerId])
}

/// Bölüm X (6. tur): Müşteri segmentasyonu — VIP / Kurumsal / Konut gibi
/// renkli etiketler. Açık ara tablo (CustomerTagAssignment) kullanıldı ki
/// etiket silinince atamalar Cascade ile temizlensin ve ileride atama
/// tarihi/atayan gibi alanlar eklenebilsin.
model CustomerTag {
  id        String   @id @default(uuid())
  name      String   @unique
  /// #RRGGBB
  color     String   @default("#3D8A4E")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  assignments CustomerTagAssignment[]
}

model CustomerTagAssignment {
  customerId String
  tagId      String
  createdAt  DateTime @default(now())

  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([tagId])
}

model Staff {
  id           String   @id @default(uuid())
  userId       String   @unique
  position     String
  salaryBase   Decimal  @db.Decimal(10, 2)
  /// Organizasyon zincirindeki üst: STAFF/TEAM_LEAD → TEAM_LEAD ise bu bir
  /// Staff.id'dir (eski davranış); STAFF/TEAM_LEAD → MANAGER'a doğrudan
  /// bağlanıyorsa bu bir User.id'dir (MANAGER'ın kendi Staff kaydı yok —
  /// bkz. lib/access.ts:resolveSupervisorInfo). Bu yüzden bilerek gerçek bir
  /// FK ilişkisi YOK (tek bir tabloya işaret etmiyor); geçerlilik
  /// controller'da (createStaff/updateStaff) uygulama seviyesinde kontrol
  /// edilir.
  supervisorId String?
  status       StaffStatus @default(AVAILABLE)
  statusUntil  DateTime?
  /// Zimmetli araç plakası (Stitch Müdür → Personel → "Zimmetli Araç").
  vehiclePlate String?
  /// Günlük iş kapasitesi — "4/5 İş (%80)" göstergesinin paydası. Boşsa
  /// yüzde gösterilmez, yalnızca iş sayısı gösterilir (uydurma kapasite yok).
  dailyJobCapacity Int?
  /// Bölüm AH (7. tur): yıllık izin hakkı (gün) — Türkiye asgari 14. Bakiye =
  /// bu değer − takvim yılında APPROVED izinlerin toplam günü (lib/leaveBalance.ts).
  annualLeaveQuotaDays Int @default(14)
  /// Bölüm AP (9. tur): kişisel takvim aboneliği (ICS) için tahmin edilemez
  /// token — GET /calendar/:token.ics requireAuth OLMADAN yalnızca bu token'la
  /// açılır (Job.calendarLink gibi tek işlik değil, personelin tüm programı).
  /// crypto.randomUUID ile ilk istendiğinde üretilir; "Token'ı Yenile" eskisini
  /// geçersiz kılar. Eski kayıtlar için null.
  calendarToken String? @unique
  createdAt    DateTime @default(now())
  /// Doldurulmuşsa bu Staff kaydı "arşivlenmiş" sayılır — MÜDÜR'e terfi
  /// (Staff kaydına artık ihtiyaç yok) veya işten çıkarma sonucu. Hiçbir
  /// veri silinmez (maaş/iş/değerlendirme geçmişi korunur); aktif personel
  /// sorgularının hepsi `archivedAt: null` ile filtrelenir. Düşürme/geri
  /// aktif etmede null'a geri döner (aynı Staff kaydı yeniden kullanılır).
  archivedAt   DateTime?

  user            User             @relation(fields: [userId], references: [id])
  jobs            Job[]            @relation("AssignedStaff")
  jobReports      JobReport[]
  advanceRequests AdvanceRequest[]
  leaveRequests LeaveRequest[]
  permissions     Permission[]
  certifications  StaffCertification[]
  unavailabilities StaffUnavailability[]
  onboardingItems OnboardingChecklistItem[]
  collectedPayments Payment[]      @relation("PaymentCollectedBy")
  evaluationsReceived Evaluation[] @relation("EvaluationTarget")
  staffBonuses    StaffBonus[]
  vehicleMaintenances VehicleMaintenance[]
  attendanceRecords   AttendanceRecord[]

  @@index([position])
  @@index([supervisorId])
  @@index([archivedAt])
}

/// Bölüm K (3. tur): Personelin "bugün öğleden sonra müsait değilim" gibi
/// hafif, anlık müsait-olmama işareti — izin talebinden (LeaveRequest, onay
/// gerektirir) AYRI. startTime/endTime null ise tüm gün. İş atamayı
/// ENGELLEMEZ; iş formunda yalnızca bilgilendirici uyarı olarak gösterilir.
model StaffUnavailability {
  id        String   @id @default(uuid())
  staffId   String
  date      DateTime @db.Date
  /// "HH:mm" — null ise tüm gün.
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, date])
  @@index([date])
}

/// Bölüm U (5. tur): yeni personel işe alım kontrol listesi — Staff
/// oluşturulunca sabit şablon (lib/onboarding.ts) transaction içinde eklenir.
/// "İlk Hafta Değerlendirmesi" EvaluationPeriod'dan bağımsız bir maddedir.
model OnboardingChecklistItem {
  id                String    @id @default(uuid())
  staffId           String
  item              String
  sortOrder         Int       @default(0)
  isCompleted       Boolean   @default(false)
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime  @default(now())

  staff       Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  completedBy User? @relation("OnboardingCompletedBy", fields: [completedByUserId], references: [id])

  @@index([staffId])
}

/// Bölüm AR (9. tur): günlük puantaj — personelin gerçek işe başlama/bitirme
/// saati (StaffUnavailability "müsait değilim" işaretinden AYRI). Gün başına
/// tek kayıt (unique staffId+date). Aynı gün ikinci giriş → 409 (çıkış yapılmış
/// olsa da; düzeltme yönetimin işi). Çıkış, giriş yoksa → 400.
model AttendanceRecord {
  id         String    @id @default(uuid())
  staffId    String
  date       DateTime  @db.Date
  clockInAt  DateTime?
  clockOutAt DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date])
}

enum VehicleMaintenanceType {
  INSPECTION
  OIL_CHANGE
  TIRE
  OTHER
}

/// Bölüm AQ (9. tur): zimmetli araç (Staff.vehiclePlate) bakım/muayene takibi.
/// nextDueDate 14 gün içindeyse günlük cron OWNER/MANAGER'a bildirir
/// (lastDueAlertAt ile günlük dedup — lastLowStockAlertAt deseni). Backend
/// vehiclePlate zorunluluğu koymaz (plaka sonradan silinse de geçmiş kalır);
/// arayüz bölümü yalnızca plakası dolu personelde gösterir.
model VehicleMaintenance {
  id              String                 @id @default(uuid())
  staffId         String
  maintenanceType VehicleMaintenanceType
  lastServiceDate DateTime               @db.Date
  nextDueDate     DateTime               @db.Date
  note            String?
  lastDueAlertAt  DateTime?
  createdAt       DateTime               @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([nextDueDate])
}

model StaffCertification {
  id          String    @id @default(uuid())
  staffId     String
  name        String
  issuedDate  DateTime
  expiryDate  DateTime
  documentUrl String?
  createdAt   DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([expiryDate])
}

model Permission {
  id        String   @id @default(uuid())
  staffId   String
  key       String
  value     Boolean  @default(false)
  createdAt DateTime @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, key])
  @@index([staffId])
}

model AdvanceRequest {
  id        String        @id @default(uuid())
  staffId   String
  amount    Decimal       @db.Decimal(10, 2)
  reason    String
  status    AdvanceStatus @default(PENDING)
  createdAt DateTime      @default(now())

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([status])
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// İzin talep/onay akışı — onaylanınca Staff.status=ON_LEAVE,
/// Staff.statusUntil=endDate olur; mevcut resetExpiredStaffStatuses cron'u
/// (lib/cron.ts) süre dolunca otomatik AVAILABLE'a döndürür, ayrı bir cron
/// gerekmez.
model LeaveRequest {
  id              String             @id @default(uuid())
  staffId         String
  startDate       DateTime
  endDate         DateTime
  reason          String
  status          LeaveRequestStatus @default(PENDING)
  requestedAt     DateTime           @default(now())
  decidedAt       DateTime?
  decidedByUserId String?
  decisionNote    String?

  staff        Staff @relation(fields: [staffId], references: [id])
  decidedByUser User? @relation("LeaveRequestDecidedBy", fields: [decidedByUserId], references: [id])

  @@index([staffId])
  @@index([status])
}

model Job {
  id               String    @id @default(uuid())
  /// İnsan-okunur iş numarası (#NLF-4819 gösterimi). Postgres sequence ile
  /// üretilir; mevcut satırlar migration sırasında otomatik numaralandırılır.
  sequenceNo       Int       @default(autoincrement())
  customerId       String
  assignedStaffId  String?
  serviceType      String
  status           JobStatus @default(PENDING)
  scheduledAt      DateTime?
  /// Randevu penceresinin bitişi ("09:30 - 11:00" gösterimi) ve zamanında
  /// tamamlama oranı hesabının referansı.
  scheduledEndAt   DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?
  notes            String?
  price            Decimal?  @db.Decimal(10, 2)
  rating           Int?
  ratingComment    String?
  /// Bölüm S (5. tur): yapılandırılmış müşteri geri bildirimi — rating/
  /// ratingComment GENEL puan olarak kalır, bunlar ek detaydır. Bir kez verilir
  /// (feedbackSubmittedAt doluysa 409).
  serviceQualityScore       Int?
  punctualityScore          Int?
  staffProfessionalismScore Int?
  wouldRecommend            Boolean?
  feedbackComment           String?
  feedbackSubmittedAt       DateTime?
  /// Bölüm Y (6. tur): garanti bitişi — tamamlanınca hesaplanır; hizmet
  /// türünde defaultWarrantyDays tanımlı değilse null.
  warrantyExpiresAt         DateTime?
  /// Bölüm N (4. tur): personelin iş öncesi günlük kontrol listesi —
  /// [{ item, isChecked, checkedAt }] (sabit şablon: lib/checklist.ts).
  /// Rapor oluşturulurken JobReport.checklist'e kopyalanır.
  checklist        Json?
  createdAt        DateTime  @default(now())

  customer       Customer    @relation(fields: [customerId], references: [id])
  assignedStaff  Staff?      @relation("AssignedStaff", fields: [assignedStaffId], references: [id])
  jobReports     JobReport[]
  photos         JobPhoto[]
  appointmentRequests AppointmentRequest[]
  complaints     CustomerComplaint[]

  @@index([customerId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([scheduledAt])
  @@index([sequenceNo])
}

model JobPhoto {
  id               String       @id @default(uuid())
  jobId            String
  url              String
  type             JobPhotoType
  uploadedByUserId String
  createdAt        DateTime     @default(now())

  job          Job  @relation(fields: [jobId], references: [id])
  uploadedBy   User @relation(fields: [uploadedByUserId], references: [id])

  @@index([jobId])
}

model JobReport {
  id            String   @id @default(uuid())
  jobId         String
  staffId       String
  productId     String?
  quantity      Decimal? @db.Decimal(10, 2)
  productsUsed  String?
  dosage        String
  notes         String?
  signatureUrl  String?
  pdfUrl        String?
  /// Müdür/patron saha raporu onayı (Stitch Müdür → İşler → "Raporu Onayla").
  approvedAt        DateTime?
  approvedByUserId  String?
  /// Bölüm N (4. tur): rapor anındaki kontrol listesi kopyası (Job.checklist).
  checklist     Json?
  createdAt     DateTime @default(now())

  job           Job            @relation(fields: [jobId], references: [id])
  staff         Staff          @relation(fields: [staffId], references: [id])
  product       Product?       @relation(fields: [productId], references: [id])
  approvedBy    User?          @relation("JobReportApprovedBy", fields: [approvedByUserId], references: [id])
  /// Eski tekli-ürün akışı için (bkz. `productId`/`quantity` alanları) —
  /// yeni raporlar `products` (JobReportProduct) kullanır, bu alan artık
  /// yalnızca geriye dönük uyumluluk için `unique` bir StockMovement taşır.
  stockMovement StockMovement?
  /// Stitch Personel → İşler: "Kullanılan Ürünler (Stoktan Düşüm)" — bir
  /// raporda BİRDEN FAZLA ürün seçilip her biri için ayrı miktar/stepper
  /// girilebilir. Her satır kendi StockMovement(OUT) kaydını üretir.
  products      JobReportProduct[]

  @@index([jobId])
  @@index([staffId])
  @@index([productId])
  @@index([approvedAt])
}

/// Bir saha raporunda kullanılan birden fazla ürünü (ve stoktan düşülen
/// miktarını) tutar — bkz. JobReport.products. Faz 9 (Personel) ile
/// eklendi: Stitch "İşler" ekranındaki çoklu ürün + miktar stepper'ı
/// gerçek bir tekli `productId`/`quantity` alanıyla karşılanamıyordu.
model JobReportProduct {
  id          String   @id @default(uuid())
  jobReportId String
  productId   String
  quantity    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  jobReport     JobReport      @relation(fields: [jobReportId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  stockMovement StockMovement?

  @@index([jobReportId])
  @@index([productId])
}

model Product {
  id                String   @id @default(uuid())
  /// Depo/stok kodu (INS-402, ROD-108 gibi) — Stitch Müdür → Stok listesi.
  code              String?
  name              String
  unit              String
  /// Etken madde / ambalaj açıklaması ("Balmumu Bazlı Parafin Blok · 5 Kg Kova").
  description       String?
  category          ProductCategory @default(BIOCIDAL)
  currentStock      Decimal  @db.Decimal(10, 2)
  criticalThreshold Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  /// Bölüm A: aynı gün içinde tekrar tekrar kritik stok bildirimi gitmesin
  /// diye — stok kritik eşiğin üstüne çıkınca null'a sıfırlanır (bkz.
  /// lib/reminders.ts:evaluateLowStockAlert).
  lastLowStockAlertAt DateTime?

  movements         StockMovement[]
  jobReports        JobReport[]
  jobReportProducts JobReportProduct[]
  purchaseRequests  StockPurchaseRequest[]
  batches           ProductBatch[]

  @@index([name])
}

/// Bölüm AM (9. tur): kimyasal parti (lot) + son kullanma tarihi takibi —
/// yasal izlenebilirlik gereksinimi. Stok girişinde (restock / mal kabul)
/// OPSİYONEL olarak açılır; stok çıkışında (iş raporu) aynı ürünün partileri
/// arasından EN ÖNCE süresi dolacak olandan düşülür (FIFO by expiry, bkz.
/// lib/productBatches.ts). Partisiz eski stok/hareketler etkilenmez.
model ProductBatch {
  id                String    @id @default(uuid())
  productId         String
  batchNumber       String
  expiryDate        DateTime  @db.Date
  quantityReceived  Decimal   @db.Decimal(10, 2)
  quantityRemaining Decimal   @db.Decimal(10, 2)
  receivedAt        DateTime  @default(now())
  supplierId        String?
  /// Günlük SKT uyarısı dedup'ı — lastLowStockAlertAt ile aynı desen.
  lastExpiryAlertAt DateTime?

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id])
  movements StockMovement[]

  @@index([productId, expiryDate])
  @@index([expiryDate])
}

model StockMovement {
  id                        String            @id @default(uuid())
  productId                 String
  type                      StockMovementType
  quantity                  Decimal           @db.Decimal(10, 2)
  /// Eski tekli-ürün raporu akışı (bkz. JobReport.productId) — yeni çoklu
  /// ürün raporları `relatedJobReportProductId` kullanır.
  relatedJobReportId        String?           @unique
  relatedJobReportProductId String?           @unique
  note                      String?
  createdAt                 DateTime          @default(now())
  /// Bölüm AM (9. tur): hareketin ait olduğu parti — eski hareketler ve
  /// partisiz giriş/çıkışlar null taşır (geriye dönük uyumluluk).
  batchId                   String?

  product                 Product           @relation(fields: [productId], references: [id])
  relatedJobReport        JobReport?        @relation(fields: [relatedJobReportId], references: [id])
  relatedJobReportProduct JobReportProduct? @relation(fields: [relatedJobReportProductId], references: [id])
  batch                   ProductBatch?     @relation(fields: [batchId], references: [id])

  @@index([productId])
  @@index([batchId])
}

/// Depo ikmal / satın alma talebi. Müdür "Satın Alma Talebi" oluşturur
/// (stok HEMEN artmaz, "Sipariş Bekleyen" olarak görünür); mal kabul
/// edildiğinde (RECEIVED) tek bir transaction içinde stok artar ve bir
/// StockMovement(IN) kaydı düşülür.
model StockPurchaseRequest {
  id               String                @id @default(uuid())
  productId        String
  quantity         Decimal               @db.Decimal(10, 2)
  status           PurchaseRequestStatus @default(PENDING)
  note             String?
  requestedByUserId String
  receivedAt       DateTime?
  receivedByUserId String?
  createdAt        DateTime              @default(now())
  /// Bölüm E: tedarikçi ve kargo/sipariş takip no — ikisi de opsiyonel,
  /// mevcut talep akışını bozmadan eklendi.
  supplierId          String?
  orderTrackingNumber String?
  /// Bölüm AI (8. tur): kritik stok taramasının otomatik açtığı öneri talebi.
  /// Normal PENDING talep gibi işlenir; yalnızca listede "Otomatik Öneri" rozeti.
  isAutoGenerated     Boolean @default(false)

  product      Product   @relation(fields: [productId], references: [id])
  requestedBy  User      @relation("PurchaseRequestedBy", fields: [requestedByUserId], references: [id])
  receivedBy   User?     @relation("PurchaseReceivedBy", fields: [receivedByUserId], references: [id])
  supplier     Supplier? @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([status])
  @@index([supplierId])
}

/// Tedarikçi kataloğu (Bölüm E) — Hizmet Türleri/Bölgeler ile aynı isim +
/// isActive deseni, ek olarak iletişim bilgileri.
model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  purchaseRequests StockPurchaseRequest[]
  batches          ProductBatch[]

  @@index([name])
}

model Contract {
  id                 String          @id @default(uuid())
  customerId         String
  startDate          DateTime
  endDate            DateTime
  durationMonths     Int
  status             String
  serviceType        String?
  amount             Decimal?        @db.Decimal(10, 2)
  pdfUrl             String?
  recurrenceType     RecurrenceType?
  nextGenerationDate DateTime?
  createdAt          DateTime        @default(now())
  /// Bölüm B (2. tur): sözleşme bitişine 7 gün veya daha az kaldığında
  /// günde bir kez OWNER/MANAGER'a hatırlatma gitsin diye — mevcut 30 günlük
  /// bilgilendirici `sendContractExpiryReminders`'dan AYRI, daha aciliyetli
  /// bir ikinci mekanizma (bkz. lib/reminders.ts:sweepContractRenewalAlerts).
  lastRenewalAlertAt DateTime?
  /// Bölüm Q (4. tur): müşteri kendi sözleşmesini duraklatabilir — duraklatılmışsa
  /// otomatik iş üretimi (lib/cron.ts) ve sağlık kontrolü bu sözleşmeyi atlar.
  isPaused           Boolean         @default(false)
  pausedAt           DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([nextGenerationDate])
}

model Payment {
  id          String   @id @default(uuid())
  customerId  String
  amount      Decimal  @db.Decimal(10, 2)
  paymentType String
  /// Dekont / referans numarası ("Dekont: #BNK-88219", "Ref #2024-89").
  referenceNo String?
  /// Saha tahsilatını yapan personel (Stitch: "Ahmet T. (Teknisyen)").
  collectedByStaffId String?
  receiptUrl  String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  collectedByStaff Staff? @relation("PaymentCollectedBy", fields: [collectedByStaffId], references: [id])

  @@index([customerId])
  @@index([paymentType])
  @@index([collectedByStaffId])
}

/// Gider takibi — net kâr hesaplaması artık tahsilat - personel maaş tabanı
/// - o aydaki toplam gideri kullanır (bkz. paymentsController.ts:
/// getPaymentsSummary). view_finance ile aynı görünürlük kuralı geçerli.
model Expense {
  id               String           @id @default(uuid())
  category         ExpenseCategory
  amount           Decimal          @db.Decimal(10, 2)
  description      String?
  date             DateTime
  recordedByUserId String
  receiptUrl       String?
  createdAt        DateTime         @default(now())

  recordedByUser User @relation(fields: [recordedByUserId], references: [id])

  @@index([category])
  @@index([date])
}

model Conversation {
  id              String   @id @default(uuid())
  participantAId  String
  participantBId  String
  createdAt       DateTime @default(now())

  participantA User      @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantB User      @relation("ConversationParticipantB", fields: [participantBId], references: [id])
  messages     Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  /// Saha fotoğrafı eki (Stitch Şef → Mesaj Detayı). Göreli yol (/uploads/...),
  /// iş fotoğraflarıyla aynı multer altyapısını kullanır.
  attachmentUrl  String?
  /// Şimdilik yalnızca "image"; ileride başka tür eklenirse ayrımı korur.
  attachmentType String?

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model QuoteRequest {
  id          String   @id @default(uuid())
  fullName    String
  phone       String
  email       String?
  propertyType String
  serviceType String
  address     String?
  district    String?
  amount      Decimal? @db.Decimal(10, 2)
  /// Müdür notu (Stitch Müdür → Teklifler → "Not Ekle").
  note        String?
  /// Keşif randevusu (Stitch → "Keşif Randevusu Ver").
  surveyAt    DateTime?
  /// Müşteriye dönüştürüldüğü an — "ortalama dönüşüm süresi" hesabı için.
  convertedAt DateTime?
  /// Bölüm AE (7. tur): status ilk kez NEW dışına (CONTACTED vb.) geçtiğinde
  /// damgalanır — "ortalama ilk temas süresi" (SLA) hesabı için; bir kez yazılır.
  firstContactedAt DateTime?
  /// Bölüm P (4. tur): formun ?ref= parametresiyle gelen davet kodu.
  referralCode String?
  status      String   @default("NEW")
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([district])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  title       String
  body        String?
  type        String?
  relatedType String?
  relatedId   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([readAt])
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ServiceType {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  /// Bölüm Y (6. tur): bu hizmet türü için varsayılan garanti süresi (gün);
  /// null ise garanti takibi yapılmaz. İş COMPLETED olduğunda
  /// Job.warrantyExpiresAt = completedAt + bu değer.
  defaultWarrantyDays Int?
  createdAt DateTime @default(now())

  appointmentRequests AppointmentRequest[]
}

/// Bölüm J (3. tur): Giriş yapmış müşterinin kendi hesabından "yeni randevu
/// istiyorum" talebi — genel (anonim) QuoteRequest formundan AYRI. Yönetim
/// talebi var olan bir Job'a bağlayarak planlar (SCHEDULED, resultingJobId)
/// veya gerekçeyle reddeder (DECLINED); her iki durumda müşteriye bildirim gider.
enum AppointmentRequestStatus {
  PENDING
  SCHEDULED
  DECLINED
}

model AppointmentRequest {
  id                 String                   @id @default(uuid())
  customerId         String
  serviceTypeId      String
  preferredDateStart DateTime
  preferredDateEnd   DateTime
  note               String?
  status             AppointmentRequestStatus @default(PENDING)
  respondedByUserId  String?
  respondedAt        DateTime?
  /// Red gerekçesi (DECLINED) — müşteriye bildirimle iletilir.
  declineReason      String?
  resultingJobId     String?
  createdAt          DateTime                 @default(now())

  customer        Customer    @relation(fields: [customerId], references: [id])
  serviceType     ServiceType @relation(fields: [serviceTypeId], references: [id])
  respondedByUser User?       @relation("AppointmentRequestRespondedBy", fields: [respondedByUserId], references: [id])
  resultingJob    Job?        @relation(fields: [resultingJobId], references: [id])

  @@index([customerId])
  @@index([status])
}

/// Bölüm T (5. tur): sık kullanılan iş türleri için şablon — iş formunda
/// "Şablondan Doldur" ile serviceType/price/notes önceden dolar, kullanıcı
/// yine değiştirebilir. Silme = isActive=false (geçmiş işler etkilenmez).
model JobTemplate {
  id                     String   @id @default(uuid())
  name                   String
  serviceType            String
  defaultPrice           Decimal? @db.Decimal(10, 2)
  defaultDurationMinutes Int?
  defaultNotes           String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())

  @@index([isActive])
}

model District {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true)
}

model NotificationPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  emailEnabled        Boolean  @default(true)
  dailyDigestEnabled  Boolean  @default(true)
  /// Bölüm AF (7. tur): Pazartesi 08:00 haftalık yönetici özeti (OWNER).
  weeklyDigestEnabled Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  loginAt      DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  logoutAt     DateTime?
  deviceInfo   String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([loginAt])
}

/// Gözlemci Modu erişim izni — OWNER, GET /conversations/all'a erişmeden önce
/// gerekçeli ve süreli (veya acil durumda süresiz) bir izin talep etmek
/// zorundadır. Bu, "OWNER'ın her şeyi görebilmesi" ile "her erişimin izlenip
/// hesap verebilir olması" arasında bir denge kurar.
model ObserverAccessGrant {
  id                String    @id @default(uuid())
  requestedByUserId String
  reason            String
  expiresAt         DateTime?
  isEmergency       Boolean   @default(false)
  createdAt         DateTime  @default(now())

  requestedBy User @relation(fields: [requestedByUserId], references: [id])

  @@index([requestedByUserId])
  @@index([expiresAt])
}

/// Formal Değerlendirme sisteminin kriter kataloğu — mevcut basit
/// Performans sayfasından (tamamlanan iş + müşteri puanı) bağımsız, ayrı bir
/// bölüm olarak eklenir; o sayfanın mantığı değişmez.
model EvaluationCriterion {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  scores EvaluationScore[]

  @@index([isActive])
}

model EvaluationPeriod {
  id        String   @id @default(uuid())
  label     String
  startDate DateTime
  endDate   DateTime
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  /// Bölüm C (2. tur): ikisi de opsiyonel — doluysa dönem kilitlenirken
  /// averageScore >= bonusThreshold olan her Evaluation için otomatik bir
  /// PENDING StaffBonus önerisi oluşturulur (para OTOMATİK ödenmez, yalnızca
  /// öneri — bkz. StaffBonus, docs/NEW_FEATURES_TOUR_2.md Bölüm C).
  bonusThreshold Int?
  bonusAmount    Decimal? @db.Decimal(10, 2)

  evaluations  Evaluation[]
  staffBonuses StaffBonus[]
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

model Evaluation {
  id              String           @id @default(uuid())
  evaluatorUserId String
  targetStaffId   String
  periodId        String
  status          EvaluationStatus @default(DRAFT)
  comment         String?
  /// Opsiyonel ek genel puan (1-20) — kriter ortalamasından (averageScore,
  /// her okumada hesaplanır) AYRIDIR, asla birbirine karışmaz/üzerine yazmaz.
  managerScore    Int?
  submittedAt     DateTime?
  lockedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  evaluator User             @relation("EvaluationEvaluator", fields: [evaluatorUserId], references: [id])
  target    Staff            @relation("EvaluationTarget", fields: [targetStaffId], references: [id])
  period    EvaluationPeriod @relation(fields: [periodId], references: [id])
  scores    EvaluationScore[]
  staffBonus StaffBonus?

  @@unique([evaluatorUserId, targetStaffId, periodId])
  @@index([targetStaffId])
  @@index([periodId])
  @@index([status])
}

enum StaffBonusStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Dönem kilitlenirken (bonusThreshold/bonusAmount tanımlıysa) otomatik
/// üretilen "onay bekleyen prim önerisi" — bkz. EvaluationPeriod. Para
/// OTOMATİK ödenmez: OWNER/MANAGER onaylayana kadar yalnızca bir öneri
/// olarak durur. Onaylanınca ayrıca bir Expense(BONUS) kaydı oluşturulur
/// (bkz. staffBonusesController.ts:approveStaffBonus) — net kâra gerçekten
/// yansıması için.
model StaffBonus {
  id                 String           @id @default(uuid())
  staffId            String
  evaluationPeriodId String
  /// Bir Evaluation'dan en fazla BİR prim önerisi çıkabilir — dönem
  /// kilitleme işlemi yanlışlıkla iki kez tetiklenirse bile mükerrer öneri
  /// oluşmasın diye tekil.
  evaluationId       String           @unique
  amount             Decimal          @db.Decimal(10, 2)
  status             StaffBonusStatus @default(PENDING)
  approvedByUserId   String?
  approvedAt         DateTime?
  createdAt          DateTime         @default(now())

  staff            Staff            @relation(fields: [staffId], references: [id])
  evaluationPeriod EvaluationPeriod @relation(fields: [evaluationPeriodId], references: [id])
  evaluation       Evaluation       @relation(fields: [evaluationId], references: [id])
  approvedByUser   User?            @relation("StaffBonusApprovedBy", fields: [approvedByUserId], references: [id])

  @@index([staffId])
  @@index([evaluationPeriodId])
  @@index([status])
}

model EvaluationScore {
  id           String @id @default(uuid())
  evaluationId String
  criterionId  String
  /// 1-20 arası, Zod ile validate edilir.
  score        Int

  evaluation Evaluation           @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterion  EvaluationCriterion  @relation(fields: [criterionId], references: [id])

  @@unique([evaluationId, criterionId])
  @@index([evaluationId])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String
  action       String
  targetUserId String
  targetType   String?
  targetId     String?
  detail       String?
  createdAt    DateTime @default(now())

  actor  User @relation("AuditLogActor", fields: [actorUserId], references: [id])
  target User @relation("AuditLogTarget", fields: [targetUserId], references: [id])

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}
